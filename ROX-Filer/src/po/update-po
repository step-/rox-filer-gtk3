#!/bin/sh

echo "Extracting messages from source files..."
echo

(cd ..; python po/tips.py &&
 intltool-extract --type=gettext/glade --update ../Templates.ui &&
 xgettext \
	--from-code=UTF-8 \
	--keyword=_ --keyword=N_ \
	--add-comments=TRANSLATORS: \
	--package-name="rox-filer-gtk3" \
	--package-version="2026.0.0b2" \
	--msgid-bugs-address="step.commons@gmail.com" \
	--copyright-holder="step" \
	--output=messages.pot *.c tips ../Templates.ui.h \
)

echo

if [ $? = 0 ]; then
	echo "Updating all .po files..."
	echo
	set -- *.po
fi

for FILE; do
	if [ ! -f "$FILE" ]; then
	  echo "$FILE does not exist!"
	  exit 1
	fi

	echo "Updating '$FILE' translation"
	mv "$FILE" "$FILE.old"
	if msgmerge -q -o "$FILE" "$FILE.old" ../messages.pot; then
		rm "$FILE.old"
	else
		mv "$FILE.old" "$FILE"
		echo "Inspect '$FILE'" >&2
		exit 1
	fi
done
