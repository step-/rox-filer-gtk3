#!/bin/sh

# Usage: update-po [--pot-only] [FILE.po ...]
# --pot-only          create ../messages.pot and exit

echo "Extracting messages from source files..."
echo

(cd ..; python po/tips.py &&
 intltool-extract --type=gettext/glade --update ../Templates.ui &&
 xgettext \
	--from-code=UTF-8 \
	--keyword=_ --keyword=N_ \
	--add-comments=TRANSLATORS: \
	--package-name="rox-filer-gtk3" \
	--package-version="26.0.0rc2" \
	--msgid-bugs-address="<https://github.com/step-/rox-filer-gtk3/issues>" \
	--copyright-holder="step" \
	--output=messages.pot *.c tips ../Templates.ui.h &&
sed -i -e '
	1 s/.*/# Translation template for the rox-filer-gtk3 file manager for X11/
	2 s/.*/# Copyright (C) 2026 step <step.commons@gmail.com>/
	' messages.pot
)
ret=$?

echo

if [ "$1" = "--pot-only" ]; then
	exit $ret
fi

if [ $? = 0 ]; then
	echo "Updating all .po files..."
	echo
	set -- *.po
fi

for FILE; do
	if [ ! -f "$FILE" ]; then
	  echo "$FILE does not exist!"
	  exit 1
	fi

	echo "Updating '$FILE' translation"
	mv "$FILE" "$FILE.old"
	if msgmerge -q -o "$FILE" "$FILE.old" ../messages.pot; then
		rm "$FILE.old"
	else
		mv "$FILE.old" "$FILE"
		echo "Inspect '$FILE'" >&2
		exit 1
	fi
done
